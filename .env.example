# ============================================================
# DEBTORA CZ — Environment Variables
# ============================================================
# FRONTEND (js/supabase-config.js) — jen veřejné hodnoty:
#   SUPABASE_URL + ANON KEY. Service-role klíč NIKDY ve frontendu.
# ------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ============================================================
# EDGE FUNCTIONS (Supabase secrets — supabase secrets set ...)
# ------------------------------------------------------------
# Service-role klíč: jen server-side (edge funkce). NIKDY ve frontendu!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Režim ověřování: mock (default) | live
VERIFY_MODE=mock

# Comgate platební brána
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true

# CEE (Smart Collectors) — aktivuje LIVE adapter (jinak 'locked'/mock)
CEE_API_URL=
CEE_API_KEY=
