# ============================================================
# DEBTORA CZ — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Supabase Project URL (from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon Key (public, safe for frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Supabase Service Role Key (SECRET - only for admin/server operations)
# NEVER expose this in frontend code in production!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
